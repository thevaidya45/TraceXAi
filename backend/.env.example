PORT=5000
NODE_ENV=development
MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Module 5 — recorded CCTV analysis (all optional; defaults in config/aiConfig.js)
AI_PYTHON_BIN=
YOLO_MODEL_PATH=
YOLO_CONFIDENCE_THRESHOLD=0.35
FRAME_INTERVAL=5
AI_MAX_SAMPLED_FRAMES=7200
AI_ITEM_ABSENCE_TOLERANCE_SECONDS=20
AI_PROCESSING_TIMEOUT_MS=3600000
AI_STALE_PROCESSING_MS=4500000
AI_TRACKER_CONFIG=bytetrack.yaml
CCTV_MAX_MB=500

# Module 6 — evidence frames and review (all optional; defaults in config/aiConfig.js)
EVIDENCE_UPLOAD_DIR=
EVIDENCE_MAX_PERSON_FRAMES=6
EVIDENCE_MAX_WIDTH=1280
EVIDENCE_JPEG_QUALITY=85
EVIDENCE_TIMEOUT_MS=300000
EVIDENCE_STALE_MS=600000
EVIDENCE_POST_OFFSET_SECONDS=10
REVIEW_WINDOW_LEAD_SECONDS=180
REVIEW_WINDOW_TRAIL_SECONDS=300
